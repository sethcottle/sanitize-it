{
  "manifest_version": 3,
  "name": "Sanitize It",
  "version": "2.1.0",
  "description": "Remove tracking information from the current page and automatically copy the URL to your clipboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs",
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "sanitize-copy": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Sanitize URL and copy to clipboard"
    },
    "sanitize-refresh": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Sanitize URL, copy to clipboard, and refresh"
    }
  }
}